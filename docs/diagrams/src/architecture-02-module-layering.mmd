flowchart TB

    subgraph Host ["AuctionServer.Api - ProjectReference to the four modules"]
        Program["Program.cs<br/>DI, authentication schemes and policies,<br/>MediatR + FluentValidation registered per module assembly"]:::host
        ApiInfra["Infrastructure/<br/>ApiKeyAuthenticationHandler, GlobalExceptionHandler,<br/>Messaging/InProcessEventPublisher"]:::host
    end

    subgraph Modules ["one module = one csproj with Presentation/ Application/ Domain/ Infrastructure/"]
        Identity["Modules.Identity<br/>IdentityDbContext, OutboxProcessor"]:::identity
        Wallets["Modules.Wallets<br/>WalletDbContext, OutboxProcessor"]:::wallets
        Auctions["Modules.Auctions<br/>AuctionDbContext, OutboxProcessor, AuctionCloser"]:::auctions
        Inventory["Modules.Inventory<br/>InventoryDbContext, OutboxProcessor"]:::inventory
    end

    Shared["AuctionServer.Shared.Integration<br/>Events/ (9 records), AppException, IIntegrationEventPublisher,<br/>IntegrationEventTypes, ValidationBehaviour"]:::shared

    Program --> Identity & Wallets & Auctions & Inventory
    Identity & Wallets & Auctions & Inventory --> Shared
    ApiInfra -.->|"implements IIntegrationEventPublisher"| Shared

