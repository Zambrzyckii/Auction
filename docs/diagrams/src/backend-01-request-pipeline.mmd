flowchart LR

    Req["Incoming request"]:::client --> Exc["UseExceptionHandler<br/>GlobalExceptionHandler"]:::host --> Authn["UseAuthentication<br/>JwtBearer (default), ApiKey (X-Api-Key)"]:::host --> Authz["UseAuthorization<br/>RequireAuthorization, policies Bot and BotProvisioning"]:::host --> Ep["Minimal API endpoint<br/>Map*Endpoints, ISender.Send"]:::host --> Val["ValidationBehaviour<br/>FluentValidation, RequestValidationException 400"]:::shared
    Val -->|"/api/users"| HI["Identity handlers"]:::identity
    Val -->|"/api/wallets"| HW["Wallets handlers"]:::wallets
    Val -->|"/api/auctions"| HA["Auctions handlers"]:::auctions
    Val -->|"/api/inventory"| HN["Inventory handlers"]:::inventory
    HI & HW & HA & HN --> Db[("PostgreSQL")]:::db
    HI & HW & HA & HN -.->|"AppException, DbUpdateConcurrencyException"| Exc

    classDef client    fill:#FFEDD5,stroke:#EA580C,stroke-width:2px,color:#7C2D12
    classDef host      fill:#E0E7FF,stroke:#4F46E5,stroke-width:2px,color:#1E1B4B
    classDef identity  fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#78350F
    classDef wallets   fill:#D1FAE5,stroke:#059669,stroke-width:2px,color:#064E3B
    classDef auctions  fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0C4A6E
    classDef inventory fill:#FFE4E6,stroke:#E11D48,stroke-width:2px,color:#881337
    classDef shared    fill:#E2E8F0,stroke:#475569,stroke-width:2px,color:#0F172A
    classDef planned   fill:#F4F4F5,stroke:#71717A,stroke-width:2px,stroke-dasharray:6 4,color:#27272A
