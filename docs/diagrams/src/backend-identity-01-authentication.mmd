flowchart TB

    Req["Request"]:::client
    B{"Authorization: Bearer header?"}
    Jwt["JwtBearer handler<br/>HS256 with Jwt:Key, ValidIssuer AuctionServer,<br/>ValidAudience AuctionServer.Client"]:::host
    Claims["ClaimsPrincipal<br/>Name = Email, NameIdentifier = PublicUserId, Role"]:::identity
    K{"X-Api-Key header?"}
    Key["ApiKeyAuthenticationHandler<br/>FixedTimeEquals against Bots:ApiKey"]:::host
    Prov["principal Name = bot-provisioner<br/>authentication type ApiKey"]:::identity
    PAuth["RequireAuthorization()<br/>POST /api/auctions, POST /api/auctions/{id}/bid, /api/inventory group"]:::shared
    PBot["policy Bot = RequireRole(Bot)<br/>POST /api/wallets/funds, POST /api/inventory/items"]:::shared
    PProv["policy BotProvisioning = scheme ApiKey<br/>POST /api/users/bots"]:::shared
    Anon["anonymous<br/>GET /api/auctions, GET /api/auctions/{id}, GET /api/wallets/{id},<br/>POST /api/users/register, POST /api/users/login"]:::shared

    Req --> B -->|"yes"| Jwt --> Claims --> PAuth & PBot
    Req --> K -->|"yes"| Key --> Prov --> PProv
    Req --> Anon

