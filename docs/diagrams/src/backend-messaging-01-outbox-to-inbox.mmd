flowchart LR

    subgraph P ["producing module - one SaveChangesAsync"]
        State["entity change<br/>e.g. Auction.CloseAuction"]:::auctions --- Out["outbox row<br/>Id = EventId, Type, Content (JSON)"]:::auctions
    end

    Out --> Proc["OutboxProcessor&lt;TContext&gt; (Shared.Infrastructure)<br/>every 3 s OutboxCourier.ClaimAsync: due, unleased rows,<br/>lease 30 s via FOR UPDATE SKIP LOCKED, ORDER BY CreatedOn, max 20;<br/>hourly cleanup of rows processed over 7 days ago"]:::shared
    Proc -->|"PublishAsync = hand-off,<br/>MarkAsProcessed on accept or broker confirm"| Pub["IIntegrationEventPublisher<br/>InProcessEventPublisher | RabbitEventPublisher"]:::host
    Pub -.->|"Rabbit: persistent message on auctionserver.events,<br/>publisher confirm awaited"| MQ["RabbitMQ queue auctionserver.deliveries<br/>RabbitDeliveryConsumer: manual ack, prefetch 20,<br/>requeue after 5 s on failure"]:::host
    Pub -.->|"4 public auction events"| Market["auctionserver.market (topic)<br/>consume-only bot feed"]:::planned
    MQ -.-> Disp
    Pub -->|"InProcess"| Disp["DeliveryDispatcher.AcceptAsync<br/>recipients and order from IntegrationEventRecipients (strict map);<br/>one DeliveryMessages row per recipient, PK (MessageId, Recipient)"]:::shared
    Disp --> DProc["DeliveryProcessor (host, one sequential instance)<br/>every 3 s DeliveryCourier.ClaimAsync: lease 30 s, ORDER BY CreatedOn, Position, max 20;<br/>IntegrationEventTypes.Deserialize, 38 registered event types;<br/>invokes that one recipient's handler; hourly cleanup"]:::shared

    subgraph Cn ["consuming module - ApplyOnceAsync, one SaveChangesAsync"]
        Chk["inbox check<br/>EventId already recorded?"]:::wallets --> Dom["domain change<br/>e.g. Wallet.SpendLockedFunds"]:::wallets --> Inb["inbox row<br/>ProcessedMessage, EventId is the primary key"]:::wallets --- Reply["reply outbox row (optional)<br/>e.g. AuctionSettledEvent"]:::wallets
    end

    DProc --> Chk
    Chk -.->|"already processed: return"| Ok["MarkAsProcessed<br/>ProcessedOn = now on the delivery row"]:::shared
    DProc -->|"handler completed"| Ok
    DProc -->|"handler threw"| Fail["FailedAttempt on that recipient's row<br/>AttemptCount++, Errors += message,<br/>NextAttemptOn = now + 2^AttemptCount x 5 s,<br/>IsDead when AttemptCount is above 5"]:::shared
    Fail -.->|"retry when due"| DProc

