flowchart LR

    subgraph P ["producing module - one SaveChangesAsync"]
        State["entity change<br/>e.g. Auction.CloseAuction"]:::auctions --- Out["outbox row<br/>Id = EventId, Type, Content (JSON)"]:::auctions
    end

    Out --> Proc["OutboxProcessor (BackgroundService)<br/>every 3 s: ProcessedOn null, not IsDead,<br/>NextAttemptOn null or past, ORDER BY CreatedOn, max 20"]:::auctions
    Proc --> Pub["IIntegrationEventPublisher<br/>InProcessEventPublisher"]:::host
    Pub --> Reg["IntegrationEventTypes.Deserialize<br/>9 registered event types"]:::shared
    Reg --> Med["MediatR IPublisher.Publish<br/>handlers one after another, registration order"]:::host

    subgraph Cn ["consuming module - one SaveChangesAsync"]
        Chk["WasEventProcessedAsync(EventId)"]:::wallets --> Dom["domain change<br/>e.g. Wallet.SpendLockedFunds"]:::wallets --> Inb["inbox row<br/>ProcessedMessage, EventId is the primary key"]:::wallets --- Reply["reply outbox row (optional)<br/>e.g. AuctionSettledEvent"]:::wallets
    end

    Med --> Chk
    Chk -.->|"already processed: return"| Ok["MarkAsProcessed<br/>ProcessedOn = now"]:::shared
    Med -->|"handler completed"| Ok
    Med -->|"handler threw"| Fail["FailedAttempt<br/>AttemptCount++, Errors += message,<br/>NextAttemptOn = now + 2^AttemptCount x 5 s,<br/>IsDead when AttemptCount is above 5"]:::shared
    Fail -.->|"retry when due"| Proc

    style P fill:#F0F9FF,stroke:#0284C7,stroke-width:2px,color:#0C4A6E
    style Cn fill:#F0FDF4,stroke:#059669,stroke-width:2px,color:#064E3B

