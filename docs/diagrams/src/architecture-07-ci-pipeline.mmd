flowchart LR

    Push["git push to gitlab.com<br/>job image mcr.microsoft.com/dotnet/sdk:10.0"]:::client

    subgraph S1 ["stage: build"]
        Build["build<br/>dotnet build Backend/AuctionServer.slnx"]:::host
    end

    subgraph S2 ["stage: test"]
        Unit["unit-tests (offline tests only)<br/>Auctions.Tests --filter FullyQualifiedName!~IntegrationTests"]:::host
        Integ["integration-tests<br/>Auctions.Tests ~IntegrationTests,<br/>then the whole Wallets, Identity and Inventory test projects"]:::host
    end

    Dind["service docker:dind<br/>DOCKER_HOST=tcp://docker:2375<br/>TESTCONTAINERS_HOST_OVERRIDE=docker"]:::shared
    Pg[("Testcontainers postgres:latest<br/>one container per test fixture")]:::db

    Push --> Build --> Unit
    Build --> Integ --> Dind --> Pg

