flowchart LR

    Push["git push to github.com<br/>runner ubuntu-latest"]:::client

    subgraph S1 ["workflow: CI"]
        Build["build<br/>dotnet build Backend/AuctionServer.slnx<br/>NuGet cache keyed on csproj hashes"]:::host
        Unit["unit-tests (offline tests only)<br/>Auctions.Tests --filter FullyQualifiedName!~IntegrationTests"]:::host
        Integ["integration-tests<br/>Auctions.Tests ~IntegrationTests,<br/>then the other ten test projects"]:::host
        Gateway["gateway-config<br/>nginx -t on the gateway configuration"]:::host
        Compose["compose-config<br/>gen-secrets.sh, docker compose config -q"]:::host
        Image["image<br/>buildx with cache type=gha,<br/>push only on main"]:::host
    end

    Pg[("Testcontainers postgres:16-alpine<br/>one container per test fixture")]:::db
    Ghcr["ghcr.io/zambrzyckii/auction<br/>tags latest and the commit sha"]:::shared

    Push --> Build --> Unit
    Build --> Integ --> Pg
    Build --> Image --> Ghcr
    Push --> Gateway
    Push --> Compose

