erDiagram
    IDENTITY__Users {
        integer Id PK "identity column"
        uuid PublicUserId "copied into other modules, no index"
        varchar Email UK "max 64"
        text PasswordHash "BCrypt"
        varchar Username "max 32"
        varchar Name "max 32"
        varchar Surname "max 32"
        date Birthday
        boolean IsDeleted "global query filter"
        integer UserRoles "Admin=0 User=1 Bot=2"
    }
    WALLETS__Wallets {
        uuid UserId PK "equals Users.PublicUserId"
        numeric AvailableFunds "18,2"
        numeric LockedFunds "18,2"
        numeric LifetimeTurnover "18,2 economy credits only"
        boolean IsSuspendedWallet "unique UserId where false"
        uuid Version "concurrency token"
    }
    AUCTIONS__Auctions {
        integer AuctionId PK "identity column"
        uuid PublicAuctionId UK
        uuid SellerUserId
        uuid ItemId "unique while Status IN (0, 1)"
        uuid CurrentWinningUserId "nullable"
        numeric CurrentPrice "18,2"
        uuid PendingBidderId "nullable, one bid in flight"
        numeric PendingBidAmount "nullable"
        integer Status "Pending=0 Active=1 Closed=2 Cancelled=3"
        text ItemName "snapshot, nullable"
        text ItemRarity "snapshot, nullable"
        numeric ItemOfficialPrice "snapshot, nullable"
        text CancellationReason "nullable"
        timestamptz CreatedOn "pending-activation timeout"
        timestamptz EndsOn
        uuid Version "concurrency token"
    }
    AUCTIONS__AuctionsBids {
        integer Id PK "identity column"
        uuid PublicAuctionId "indexed"
        uuid BidderUserId
        numeric Amount "18,2"
        timestamptz PlacedOn "appended on ConfirmPendingBid"
    }
    WALLETS__WalletsFundsLocks {
        integer Id PK "identity column"
        uuid WalletUserId FK "cascade delete"
        uuid PublicAuctionId "unique with WalletUserId while Status = 0"
        numeric Amount "18,2"
        integer Status "Active=0 Released=1 Consumed=2"
    }
    WALLETS__WalletsTransfers {
        integer Id PK "identity column"
        uuid SenderUserId "indexed"
        uuid RecipientUserId "indexed"
        numeric Amount "18,2"
        timestamptz SentOn "appended with the balance changes"
    }
    INVENTORY__InventoryItems {
        integer Id PK "identity column"
        uuid PublicItemId UK
        uuid OwnerUserId
        text Name
        integer Rarity "Common=0 Rare=1 Epic=2 Legendary=3"
        integer Status "Available=0 LockedForAuction=1 SoldToShop=2 Consumed=3"
        numeric OfficialPrice "18,2"
        uuid LockedForAuctionId UK "nullable"
        uuid Version "concurrency token"
    }
    WAREHOUSES__WarehousesWars {
        integer Id PK "identity column"
        uuid PublicWarehouseId UK
        varchar Tier "max 32, sets fee and increments"
        integer Status "Stocking=0 Open=1 Bidding=2 Settled=3 Cancelled=4"
        numeric TotalValue "18,2 hidden"
        numeric EstimateMin "18,2 shown"
        numeric EstimateMax "18,2 shown"
        numeric EntryFee "18,2 also the bid budget"
        numeric CurrentPrice "18,2"
        uuid CurrentLeaderId "nullable"
        timestamptz BiddingStartsOn "nullable, set = countdown running"
        timestamptz BiddingEndsOn "nullable, reset on every raise"
        text CancellationReason "nullable"
        timestamptz CreatedOn "lobby timeout"
        uuid Version "concurrency token"
    }
    WAREHOUSES__WarehousesParticipants {
        integer Id PK "identity column"
        integer WarehouseWarId FK "cascade delete, unique with UserId"
        uuid UserId
        integer State "PendingLock=0 Active=1"
    }
    WAREHOUSES__WarehousesStockItems {
        integer Id PK "identity column"
        uuid PublicWarehouseId "indexed"
        varchar Name "max 100"
        varchar Rarity "max 16, stored as text"
        numeric Price "18,2 minted at settlement"
    }
    BANKING__BankingLoans {
        integer Id PK "identity column"
        uuid PublicLoanId UK
        uuid UserId "unique while Status IN (0, 1, 2, 3)"
        varchar OfferName "max 64, snapshot"
        numeric Principal "18,2 snapshot"
        numeric InterestRate "5,4 snapshot"
        numeric PenaltyRate "5,4 snapshot"
        numeric RequiredTurnover "18,2 snapshot"
        interval Term "snapshot"
        numeric TotalDue "18,2 frozen at Create"
        numeric Penalty "18,2 charged once"
        numeric AmountRepaid "18,2"
        integer Status "PendingApproval=0 Active=1 CollectionPending=2 Overdue=3 Repaid=4 Rejected=5"
        timestamptz RequestedOn "approval timeout"
        timestamptz DueOn "nullable, set on Approve"
        timestamptz LastCollectionRequestedOn "nullable, retry and abort cutoff"
        timestamptz OverdueSince "nullable, penalty charged marker"
        timestamptz RepaidOn "nullable"
        text RejectionReason "nullable, max 256"
        uuid Version "concurrency token"
    }
    IDENTITY__IdentityOutboxMessages {
        uuid Id PK
    }
    WALLETS__WalletsOutboxMessages {
        uuid Id PK
    }
    WALLETS__WalletsProcessedMessages {
        uuid EventId PK
    }
    AUCTIONS__OutboxMessages {
        uuid Id PK "the only table without a module prefix"
    }
    AUCTIONS__AuctionsProcessedMessages {
        uuid EventId PK
    }
    INVENTORY__InventoryOutboxMessages {
        uuid Id PK
    }
    INVENTORY__InventoryProcessedMessages {
        uuid EventId PK
    }
    WAREHOUSES__WarehousesOutboxMessages {
        uuid Id PK
    }
    WAREHOUSES__WarehousesProcessedMessages {
        uuid EventId PK
    }
    BANKING__BankingOutboxMessages {
        uuid Id PK
    }
    BANKING__BankingProcessedMessages {
        uuid EventId PK
    }
    AUCTIONS__Auctions ||..o{ AUCTIONS__AuctionsBids : "PublicAuctionId, no FK"
    WALLETS__Wallets ||--o{ WALLETS__WalletsFundsLocks : "WalletUserId, real FK, owned by the aggregate"
    WALLETS__Wallets ||..o{ WALLETS__WalletsTransfers : "SenderUserId and RecipientUserId, no FK"
    AUCTIONS__Auctions |o..o{ WALLETS__WalletsFundsLocks : "PublicAuctionId, no FK"
    IDENTITY__Users ||..|| WALLETS__Wallets : "UserId = PublicUserId, no FK"
    IDENTITY__Users ||..o{ AUCTIONS__Auctions : "SellerUserId and CurrentWinningUserId, no FK"
    IDENTITY__Users ||..o{ INVENTORY__InventoryItems : "OwnerUserId, no FK"
    INVENTORY__InventoryItems |o..o| AUCTIONS__Auctions : "ItemId = PublicItemId and LockedForAuctionId = PublicAuctionId, no FK"
    WAREHOUSES__WarehousesWars ||--o{ WAREHOUSES__WarehousesParticipants : "WarehouseWarId, real FK, owned by the aggregate"
    WAREHOUSES__WarehousesWars ||..o{ WAREHOUSES__WarehousesStockItems : "PublicWarehouseId, no FK"
    WAREHOUSES__WarehousesWars |o..o{ WALLETS__WalletsFundsLocks : "PublicWarehouseId stored in PublicAuctionId, no FK"
    IDENTITY__Users ||..o{ WAREHOUSES__WarehousesParticipants : "UserId, no FK"
    IDENTITY__Users ||..o{ BANKING__BankingLoans : "UserId, no FK"
    WALLETS__Wallets |o..o{ BANKING__BankingLoans : "UserId, disbursement and collection via events only"
